import os
import secrets

# Generate the secret used by Grist to sign session cookies. Secrets must
# not go through agent.set_env(), which stores values in Redis: keep it in
# a private file, included in the module backup (see etc/state-include.conf)
# and loaded by the systemd unit.
path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    fp.write(f"GRIST_SESSION_SECRET={secrets.token_hex(32)}\n")
