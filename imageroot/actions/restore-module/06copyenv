import sys
import json
import agent

request = json.load(sys.stdin)

original_environment = request["environment"]

for evar in [
    "TRAEFIK_HOST",
    "TRAEFIK_HTTP2HTTPS",
    "TRAEFIK_LETS_ENCRYPT",
    "GRIST_DEFAULT_EMAIL",
    "GRIST_SINGLE_ORG",
]:
    # GRIST_SINGLE_ORG is unset when a multi-team site was configured
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
