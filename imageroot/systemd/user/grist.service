#
# This systemd unit starts a Grist instance using Podman.
#
[Unit]
Description=Grist spreadsheet-database

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# GRIST_SESSION_SECRET, generated by create-module (secret, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/grist.pid %t/grist.ctr-id
# Variables without a value are passed through from the unit environment,
# and skipped by Podman if they are unset (GRIST_SINGLE_ORG is optional).
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/grist.pid \
    --cidfile=%t/grist.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --volume=grist-data:/persist:Z \
    --publish=127.0.0.1:${TCP_PORT}:8484 \
    --env=APP_HOME_URL \
    --env=GRIST_DEFAULT_EMAIL \
    --env=GRIST_SINGLE_ORG \
    --env=GRIST_SESSION_SECRET \
    ${GRIST_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/grist.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/grist.ctr-id
PIDFile=%t/grist.pid
Type=forking

[Install]
WantedBy=default.target
